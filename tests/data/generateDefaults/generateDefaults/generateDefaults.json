{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "https://example.com/generateDefaults",
  "type": "object",
  "definitions": {
    "Nested": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "default": "nested-default"
        }
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "default": "hello"
    },
    "count": {
      "type": "integer",
      "default": 42
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["a", "b"]
    },
    "timeout": {
      "type": "string",
      "format": "duration",
      "default": "PT1M30S"
    },
    "description": {
      "type": "string"
    },
    "nested": {
      "$ref": "#/definitions/Nested"
    }
  },
  "required": ["name", "description"]
}
